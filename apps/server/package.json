    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@looptalk/shared": "*",
    "connect-pg-simple": "^10.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
