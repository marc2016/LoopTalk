# Vorlage für den Betrieb mit compose.prod.yaml. Kopieren nach .env und anpassen.
# Für die Entwicklung (docker compose up) ist keine .env nötig.

# Öffentliche URL der App (hinter dem Reverse Proxy, mit TLS)
BASE_URL=https://looptalk.example.com

# Session-Cookie signieren: mindestens 32 zufällige Zeichen, z. B. `openssl rand -hex 32`
SESSION_SECRET=

# PostgreSQL
POSTGRES_USER=looptalk
POSTGRES_PASSWORD=
POSTGRES_DB=looptalk
# Wird in compose.prod.yaml aus den Werten oben gebildet; nur setzen, wenn die DB extern läuft.
# DATABASE_URL=postgres://looptalk:<passwort>@db:5432/looptalk

# Dex (OIDC)
DEX_ISSUER=https://dex.example.com/dex
# Optional: interne Adresse, falls der Server Dex nicht unter DEX_ISSUER erreicht
# DEX_INTERNAL_URL=http://dex:5556
OIDC_CLIENT_ID=looptalk
OIDC_CLIENT_SECRET=
